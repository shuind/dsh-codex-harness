{
  "name": "@shuind/dsh-codex-harness",
  "version": "0.3.0",
  "packageManager": "pnpm@9.15.9",
  "description": "Customizable Codex coding preset, tools and Responses enhancements for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/entries/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/entries/index.d.ts", "default": "./lib/index.js" },
    "./preferences": { "types": "./lib/types/entries/preferences.d.ts", "default": "./lib/preferences.js" },
    "./compaction": { "types": "./lib/types/entries/compaction.d.ts", "default": "./lib/compaction.js" },
    "./tool-policy": { "types": "./lib/types/entries/tool-policy.d.ts", "default": "./lib/tool-policy.js" },
    "./tool-policy/locale/*.json": "./locale/tool-policy/*.json",
    "./tool-policy/icon": "./assets/codex.svg",
    "./hybrid-executor": { "types": "./lib/types/entries/hybrid-executor.d.ts", "default": "./lib/hybrid-executor.js" },
    "./hybrid-executor/locale/*.json": "./locale/hybrid-executor/*.json",
    "./hybrid-executor/icon": "./assets/codex.svg",
    "./compact-command": { "types": "./lib/types/entries/compact-command.d.ts", "default": "./lib/compact-command.js" },
    "./typert": { "types": "./lib/types/entries/typert.host.d.ts", "default": "./lib/typert.js" },
    "./client": { "types": "./lib/types/entries/client.d.ts", "default": "./lib/client.js" },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/codex.svg",
    "./preferences/locale/*.json": "./locale/*.json",
    "./preferences/icon": "./assets/codex.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "docs/preset-library.md",
    "docs/tool-policy.md",
    "docs/tool-policy-benchmark.json",
    "lib/index.js",
    "lib/preferences.js",
    "lib/compaction.js",
    "lib/compact-command.js",
    "lib/tool-policy.js",
    "lib/hybrid-executor.js",
    "lib/typert.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/client.js",
    "src",
    "scripts/build-preset.mjs",
    "scripts/clean-build.mjs",
    "scripts/benchmark-tool-policy.mjs",
    "tsconfig.json",
    "tsdown.config.ts",
    "cordis.patch.yml",
    "presets/codex-hybrid",
    "locale/*.json",
    "locale/tool-policy/*.json",
    "locale/hybrid-executor/*.json",
    "assets/codex.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "RELEASE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc --noCheck -p tsconfig.json && node scripts/build-preset.mjs && tsdown",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --pool=threads",
    "bench:tools": "node scripts/benchmark-tool-policy.mjs",
    "pack:check": "npm pack --dry-run",
    "prepare": "npm run build"
  },
  "repository": { "type": "git", "url": "git+https://github.com/shuind/dsh-codex-harness.git" },
  "keywords": ["dsh-plugin", "deepseek-harness", "codex", "agent"],
  "publishConfig": { "access": "public" },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <=0.2.2-rc.4"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
